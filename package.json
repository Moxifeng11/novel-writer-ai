{
  "name": "novel-writer-ai",
  "version": "4.55.0",
  "description": "Obsidian plugin for AI-powered novel writing",
  "main": "main.js",
  "scripts": {
    "version:sync": "node scripts/sync-version.js",
    "gen:templates": "node scripts/generate-template-assets.mjs",
    "check:templates": "node scripts/generate-template-assets.mjs --check",
    "check:release": "node scripts/check-release.mjs",
    "build": "node scripts/sync-version.js && node scripts/generate-template-assets.mjs && node scripts/build-styles.mjs && node scripts/build.js",
    "build:release": "npm run preflight:release",
    "preflight": "npm run typecheck && npm run lint && npm run test && npm run check:templates && npm run check:styles && npm run check:css && npm run check:inline-styles && npm run check:deps -- --baseline .arch-baseline.json --require-baseline && npm run check-engines && npm run check:program && npm run check:relationship-authority && npm run check:silent-failures && npm run check:hotpaths && npm run check:write-entry && npm run check:linked-scenarios && npm run check:automation && npm run check:dsh-isolation && npm run check:jsdoc && npm run check:any && npm run check:changelog && npm run check:docs && npm run build && npm run check:bundle && npm run check:release",
    "preflight:release": "npm run preflight && npm run test:cov",
    "dev": "node scripts/sync-version.js && node scripts/generate-template-assets.mjs && node scripts/build-styles.mjs && node scripts/build.js --watch",
    "build:styles": "node scripts/build-styles.mjs",
    "check:styles": "node scripts/build-styles.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --max-old-space-size=4096 node_modules/vitest/vitest.mjs run",
    "test:cov": "node --max-old-space-size=4096 node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "check-engines": "node scripts/scan-engine-instances.mjs --check --baseline .arch-baseline.json --require-baseline",
    "check:deps": "node scripts/check-dependencies.mjs",
    "check:css": "node scripts/check-css.js",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:inline-styles": "node scripts/check-inline-styles.mjs",
    "css:baseline": "node scripts/check-css.js --update-baseline",
    "inline:baseline": "node scripts/check-inline-styles.mjs --update-baseline",
    "eval:fingerprint": "node scripts/eval-fingerprint-retrieval.mjs",
    "eval:rag": "node scripts/eval-rag-retrieval.mjs",
    "sample:human": "node scripts/sample-human-corpus.mjs",
    "eval:humanness": "vitest run --config vitest.benchmark.config.ts tests/benchmark/humanness-benchmark.test.ts",
    "css:cleanup": "node scripts/cleanup-css.js",
    "css:stats": "node scripts/stats-css.js",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint . --max-warnings 1890",
    "eval:quality": "vitest run --config vitest.benchmark.config.ts --reporter=json --outputFile=benchmarks/quality/last-report.json",
    "eval:cowrite-local": "node scripts/eval-cowrite-local.mjs",
    "program:render": "node scripts/program-status.mjs",
    "check:program": "node scripts/program-status.mjs --check",
    "gen:docs": "node scripts/gen-docs.mjs",
    "handoff": "node scripts/handoff.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:jsdoc": "node scripts/check-jsdoc.mjs",
    "check:any": "node scripts/check-any-budget.mjs",
    "any:baseline": "node scripts/check-any-budget.mjs --update-baseline",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:relationship-authority": "node scripts/check-relationship-authority.mjs",
    "check:silent-failures": "node scripts/check-silent-failures.mjs",
    "check:hotpaths": "node scripts/check-hotpath-scans.mjs",
    "check:write-entry": "node scripts/check-write-entry.mjs",
    "check:linked-scenarios": "node scripts/check-linked-scenarios.mjs",
    "check:automation": "node scripts/check-automation.mjs",
    "check:dsh-isolation": "node scripts/check-dsh-isolation.mjs",
    "bench:hotpath": "node scripts/bench/get-files-hotpath.mjs"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "novel",
    "writing",
    "AI"
  ],
  "author": "Trae AI",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wait-on": "^9.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moxifeng11/novel-writer-ai.git"
  },
  "homepage": "https://github.com/Moxifeng11/novel-writer-ai#readme",
  "bugs": {
    "url": "https://github.com/Moxifeng11/novel-writer-ai/issues"
  }
}
