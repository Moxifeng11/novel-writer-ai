{
  "name": "novel-writer-ai",
  "version": "4.13.0",
  "description": "Obsidian plugin for AI-powered novel writing",
  "main": "main.js",
  "scripts": {
    "version:sync": "node scripts/sync-version.js",
    "gen:templates": "node scripts/generate-template-assets.mjs",
    "check:templates": "node scripts/generate-template-assets.mjs --check",
    "check:release": "node scripts/check-release.mjs",
    "build": "node scripts/sync-version.js && node scripts/generate-template-assets.mjs && node scripts/build.js",
    "build:release": "npm run preflight && npm run build",
    "preflight": "npm run typecheck && npm run test && npm run check:templates && npm run check:css && npm run check:inline-styles && npm run check:deps -- --baseline .arch-baseline.json && npm run check-engines -- --baseline .arch-baseline.json",
    "dev": "node scripts/sync-version.js && node scripts/generate-template-assets.mjs && node scripts/build.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "check-engines": "node scripts/scan-engine-instances.mjs --check",
    "check:deps": "node scripts/check-dependencies.mjs",
    "check:css": "node scripts/check-css.js",
    "check:inline-styles": "node scripts/check-inline-styles.mjs",
    "css:baseline": "node scripts/check-css.js --update-baseline",
    "inline:baseline": "node scripts/check-inline-styles.mjs --update-baseline",
    "eval:fingerprint": "node scripts/eval-fingerprint-retrieval.mjs",
    "css:cleanup": "node scripts/cleanup-css.js",
    "css:stats": "node scripts/stats-css.js",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "novel",
    "writing",
    "AI"
  ],
  "author": "Trae AI",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "^0.19.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.5.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^1.6.1",
    "wait-on": "^9.0.10"
  }
}
